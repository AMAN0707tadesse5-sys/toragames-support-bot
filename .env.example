# === Telegram ===
# Token from @BotFather
BOT_TOKEN=8645567502:AAEvzi6ArRfaiqO0Mlaq65lbFUIVQJ6obUY

# Numeric chat ID of the admin group/channel that receives support tickets
# (Add the bot to the group as admin, then use a tool like @userinfobot or
#  getUpdates to find the group's chat_id. Group IDs are usually negative.)
ADMIN_CHAT_ID=-4345056023

# === Branding ===
# Direct URL to the welcome/banner image shown on /start
WELCOME_IMAGE_URL=https://toragames.com/assets/banner.jpg

# Support handle shown in the "Contact Support" menu
SUPPORT_HANDLE=@zamanueltadesse

# === Webhook / Render deployment ===
# Public base URL of your Render service, e.g. https://toragames-support-bot.onrender.com
# Leave EMPTY for local development -> the bot falls back to long polling automatically.
WEBHOOK_URL=

# Random secret path segment so nobody can guess/spam your webhook endpoint.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET_PATH=change-this-to-a-random-string

# Render injects PORT automatically in production; only needed for local override.
PORT=3000

# === Misc ===
# development | production
NODE_ENV=development
